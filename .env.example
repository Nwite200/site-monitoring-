# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ADMIN_EMAIL: Single admin email address for console login and alert notifications.
# If omitted, defaults to 'vresounding@gmail.com'.
ADMIN_EMAIL="vresounding@gmail.com"

# ADMIN_PASSWORD: Secure password for locking access to the SiteGuard dashboard.
# If omitted, defaults to 'siteguard123'. Change this immediately to secure your dashboard.
ADMIN_PASSWORD="siteguard123"

# RESEND_API_KEY: Optional. Your Resend API key for sending email alerts.
# If configured, emails will be delivered automatically via Resend.
RESEND_API_KEY=""

# EMAIL_FROM: Optional. Email sender address (e.g., alerts@yourdomain.com).
# Defaults to 'alerts@siteguard.ai'.
EMAIL_FROM="alerts@siteguard.ai"

# VITE_API_URL: Optional (Frontend-only). Point to your hosted backend Express API.
# Leave empty if deploying a unified full-stack server (default).
# Example: VITE_API_URL="https://my-backend-service.run.app"
VITE_API_URL=""

# ==========================================================
# MySQL Database Connection (Optional - For Namecheap Shared Hosting / MySQL)
# ==========================================================
# If these variables are set, SiteGuard will automatically connect to MySQL 
# and use it instead of Firebase Firestore.
DB_HOST="localhost"
DB_PORT="3306"
DB_USER=""
DB_PASSWORD=""
DB_NAME=""


